# ── AI Provider ───────────────────────────────────────────────
# Set ai.provider in config/config.yaml to "anthropic" or "openai"
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# ── Personal Profile (kept out of git) ────────────────────────
PROFILE_NAME=Your Full Name
PROFILE_EMAIL=your@email.com
PROFILE_PHONE=9999999999
PROFILE_PHONE_WITH_CODE=+91 9999999999
PROFILE_GENDER=Male
PROFILE_NATIONALITY=Indian
PROFILE_LOCATION=Mumbai, India
PROFILE_LINKEDIN=https://linkedin.com/in/yourprofile
PROFILE_GITHUB=https://github.com/yourusername
PROFILE_PORTFOLIO=https://yourportfolio.com

# ── Experience ────────────────────────────────────────────────
EXP_YEARS=4
EXP_CURRENT_CTC=16 LPA
EXP_EXPECTED_CTC=35 LPA
EXP_NOTICE_PERIOD=30 days
EXP_CURRENT_COMPANY=Your Company
EXP_CURRENT_DESIGNATION=Software Engineer

# ── Education ─────────────────────────────────────────────────
EDU_DEGREE=B.E. in Information Technology
EDU_FIELD=Information Technology
EDU_COLLEGE=Your College Name
EDU_GRADUATION_YEAR=2022

# ── Chrome / Dashboard ────────────────────────────────────────
CHROME_DEBUG_PORT=9222
DASHBOARD_PORT=8000
